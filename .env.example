# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# === Integration Settings ===

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Binance Crypto Exchange ===
# Create API key at: https://www.binance.com/en/my/settings/api-management
# Recommended permissions: Read + Trade (NO Withdrawal)
# Set IP whitelist for production security
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET=true   # Set to false ONLY for live trading

# Alpaca Brokerage (legacy stock trading — kept for backward compatibility)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Redis Order Queue
REDIS_URL=redis://localhost:6379/0

# Pinecone RAG Memory
PINECONE_API_KEY=

# === Autonomous Mode Settings ===

# Scan interval
SCAN_INTERVAL_MINUTES=60
MAX_TICKERS_PER_SCAN=3
TICKER_COOLDOWN_HOURS=4

# Crypto scanner thresholds
CRYPTO_MIN_VOLUME_USD=10000000   # Min 24h volume in USD ($10M)
CRYPTO_MIN_PRICE_CHANGE_PCT=3.0  # Min absolute 24h price change %
CRYPTO_QUOTE_ASSET=USDT

# Custom watchlist (comma-separated Binance pairs), used when SCANNER_UNIVERSE=custom
SCANNER_UNIVERSE=default
# SCANNER_CUSTOM_WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
